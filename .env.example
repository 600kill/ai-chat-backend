# ============================================================
# 环境变量模板（复制为 .env 后填入真实值；切勿提交真实密钥）
# ============================================================

# ===== 应用（development/test/staging/production）=====
APP_ENV=development

# ===== JWT 认证（生产环境务必改成随机长字符串）=====
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# ===== LLM 主链路：本地 LLM 网关（LiteLLM Proxy，OpenAI 兼容协议）=====
# Agent 对话 / mem0 记忆抽取 / 评测 Judge 全部走该网关
GATEWAY_BASE_URL=http://localhost:4000/v1
GATEWAY_API_KEY=sk-your-gateway-key
GATEWAY_MODEL=your/model-name
DEFAULT_LLM_MODEL=your/model-name

# ===== 评测 Judge（与主对话同走网关，避免硬绑单一供应商）=====
JUDGE_MODEL=your/model-name
JUDGE_BASE_URL=http://localhost:4000/v1
JUDGE_API_KEY=sk-your-gateway-key

# ===== Langfuse 可观测性（自托管；不启用可置 false）=====
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key

# ===== PostgreSQL（pgvector 镜像 pg16）=====
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ===== Redis（RQ 评测任务队列；worker 见下方启动说明）=====
REDIS_URL=redis://localhost:6379/0

# ===== RAG 知识库 / Embedding =====
# provider=local：本地 sentence-transformers 模型（无需 API，bge-small-zh = 512 维）
# provider=openai：OpenAI 兼容远程接口（如 text-embedding-v2 = 1536 维）
# 注意：向量维度在建表时固化，切换 provider/维度需重建 knowledge_chunk 表
RAG_EMBEDDING_PROVIDER=local
RAG_LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_DIM=512
# 切回远程 OpenAI 兼容 embedding 时：
#RAG_EMBEDDING_PROVIDER=openai
#RAG_EMBEDDING_MODEL=text-embedding-v2
#RAG_EMBEDDING_BASE_URL=https://your-openai-compatible-endpoint/v1
#RAG_EMBEDDING_API_KEY=sk-your-embedding-key
#RAG_EMBEDDING_DIM=1536
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=4
RAG_MAX_UPLOAD_MB=10

# ===== 长时记忆（mem0：LLM 走网关，embedding 用本地 bge）=====
LONG_TERM_MEMORY_MODEL=your/model-name
LONG_TERM_MEMORY_EMBEDDER_MODEL=BAAI/bge-small-zh-v1.5
LONG_TERM_MEMORY_EMBEDDING_DIMS=512
